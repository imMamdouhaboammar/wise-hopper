# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Resend Email Configuration (leave empty to use local sandbox logger)
RESEND_API_KEY=
RESEND_FROM_EMAIL=newsletter@example.com

# Billing Configuration
# Mode: "simulated" | "lemonsqueezy" | "paymob" | "stripe"
BILLING_PROVIDER=simulated
BILLING_WEBHOOK_SECRET=local-simulated-webhook-secret-32-bytes-long

# Lemon Squeezy (if BILLING_PROVIDER=lemonsqueezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_ANNUAL_VARIANT_ID=

# Paymob (if BILLING_PROVIDER=paymob)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# Stripe (if BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
